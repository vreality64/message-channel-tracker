{
  "name": "message-channel-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint --reporter=summary .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format --write .",
    "prepush": "pnpm run lint && pnpm run test",
    "prepare": "husky",
    "docs:serve": "python3 -m http.server 5174 --directory docs --bind 127.0.0.1",
    "docs:open": "open http://localhost:5174/",
    "docs": "pnpm run docs:serve",
    "hero:capture:tip": "echo '1) pnpm run docs && open http://localhost:5174/hero-demo.html\n2) 화면 녹화(QuickTime 등)로 6–8초 캡처\n3) 파일을 docs/assets/hero-src.mp4 로 저장한 뒤, 아래 명령으로 변환'",
    "hero:gif": "ffmpeg -y -i ./docs/assets/hero-src.mp4 -filter_complex 'fps=24,scale=960:-1:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=single:max_colors=256[p];[s1][p]paletteuse=dither=sierra2_4a' -loop 0 ./docs/assets/hero.gif",
    "hero:gif:hq": "pnpm run hero:gif",
    "hero:webp": "ffmpeg -y -i ./docs/assets/hero-src.mp4 -vf fps=24,scale=960:-1:flags=lanczos -loop 0 -preset picture -an -lossless 0 -quality 92 -compression_level 4 ./docs/assets/hero.webp",
    "hero:webp:ultra": "ffmpeg -y -i ./docs/assets/hero-src.mp4 -vf fps=30,scale=1200:-1:flags=lanczos -loop 0 -preset picture -an -lossless 0 -quality 95 -compression_level 3 ./docs/assets/hero.webp",
    "hero:webp:lossless": "ffmpeg -y -i ./docs/assets/hero-src.mp4 -vf fps=24,scale=960:-1:flags=lanczos -loop 0 -preset picture -an -lossless 1 -compression_level 4 ./docs/assets/hero.webp",
    "hero:optim:gif": "gifsicle -O3 ./docs/assets/hero.gif -o ./docs/assets/hero.gif",
    "hero:optim:webp": "cwebp -q 90 ./docs/assets/hero.webp -o ./docs/assets/hero.webp"
  },
  "devDependencies": {
    "happy-dom": "^18.0.1",
    "vitest": "^1.6.0",
    "@biomejs/biome": "^1.8.3",
    "husky": "^9.1.6"
  }
}
