{
  "manifest_version": 3,
  "name": "__MSG_appTitle__",
  "version": "2.0.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "__MSG_appTitle__",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/tracker.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
