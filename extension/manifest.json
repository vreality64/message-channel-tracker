{
  "manifest_version": 3,
  "name": "__MSG_appTitle__",
  "version": "2.2.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "__MSG_appTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/tracker.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
