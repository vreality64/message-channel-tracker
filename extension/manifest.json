{
  "manifest_version": 3,
  "name": "__MSG_appTitle__",
  "version": "1.0.4",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "__MSG_appTitle__",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/tracker.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
