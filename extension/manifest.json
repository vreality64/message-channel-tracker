{
  "manifest_version": 3,
  "name": "__MSG_appTitle__",
  "version": "1.0.3",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "__MSG_appTitle__",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["tracker.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
